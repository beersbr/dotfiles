[user]
	email = beersbr@gmail.com
	name = B
[core]
	autocrlf = input
    editor = nvim
[alias]
	ll = log --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%ci) %C(bold blue)<%an>%Creset'
	unadd = reset HEAD --
[init]
	defaultBranch = main
[commit]
	gpgsign = false
[tag]
	gpgsign = false
[pull]
    rebase = true
[rebase]
    autoStash = true
